STRIPE_PUBLISHABLE_KEY=pk_test_51TfGsx4sActfFZskv4KaRe70MlFYfSXz7pziwpQdY832en8IfMIqALSs1efCtwiGntjHG0Xr1CLemyDZQUW7lgyP003xdWD4si

# URL del Google Apps Script che riceve i form "Richiedi informazioni"
