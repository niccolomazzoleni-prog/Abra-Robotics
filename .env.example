# ── Abra Robotics — variabili d'ambiente (NON committare il .env reale) ──
# Usate SOLO da script locali lato server (es. prodotti/_gen_stripe.py).
# La secret key NON finisce mai nel frontend / repo.

# Secret key Stripe (TEST: sk_test_..., LIVE: sk_live_...). Solo locale/server — mai nel repo.
# Sandbox: python scripts/connect_stripe_sandbox.py
# Live:    python scripts/connect_stripe_live.py  (richiede sk_live_ + pk_live_ dalla dashboard)
STRIPE_SECRET_KEY=sk_test_xxx

# Publishable key Stripe (pubblica, finisce in stripe-config.js). pk_test_... / pk_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Opzionale — solo se attivi webhook serverless (vedi stripe/webhook.example.js)
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL del Google Apps Script che riceve i form "Richiedi informazioni"
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
